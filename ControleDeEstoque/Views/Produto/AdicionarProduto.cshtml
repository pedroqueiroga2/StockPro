@model ControleDeEstoque.Application.DTO.ProdutoDto;


@{
    Layout = "_Layout";
}
<style>
    .sem-seta::-webkit-inner-spin-button,
    .sem-seta::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .sem-seta {
        -moz-appearance: textfield;
    }

</style>
<form asp-controller="Produto" asp-action="CadastrarProduto" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label for="nome" class="fw-bold">Informe o nome do produto</label>
        <input type="text" asp-for="nmProduto" class="form-control" placeholder="Digite o nome do produto">
        <span asp-validation-for="nmProduto" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="quantidade" class="fw-bold">Quantidade</label>
        <input type="number" asp-for="qtdEstoque" class="form-control" placeholder="Informe a quantidade do produto em Estoque">
        <span asp-validation-for="qtdEstoque" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="preco" class="fw-bold">Preço</label>
        <input asp-for="Preco" class="form-control" placeholder="Informe o preço do produto">
        <span asp-validation-for="Preco" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="imagem" class="form-label">Foto</label>
        <input  class="form-control" type="file" placeholder="Informe o preço do produto">
    </div>
    
    

    <br />
    <button type="submit" class="btn btn-success">Adicionar</button>

    <a class="btn btn-secondary" asp-controller="Produto" asp-action="Index">Voltar</a>
</form>