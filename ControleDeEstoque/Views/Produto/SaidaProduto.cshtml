@model ControleDeEstoque.Domain.Entities.ProdutoModel;

@{
  
    Layout = "_Layout";

}
<style>
    .sem-seta::-webkit-inner-spin-button,
    .sem-seta::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .sem-seta {
        -moz-appearance: textfield;
    }

</style>
<h2>@Model.nmProduto</h2>
<form asp-controller="Produto" asp-action="SaidaProduto" method="post">
    <input type="hidden" name="id" value="@Model.cdProduto" />

    <div class="form-group">
        <label for="quantidade" class="fw-bold">Informe a quantidade de produtos de saída</label>
        <input type="number" name="quantidade" class="form-control sem-seta" required min="1">
    </div>  
    <div class="form-group">
        <label for="quantidade" class="fw-bold">Motivo da Saída</label>
        <input type="number" name="quantidade" class="form-control sem-seta" required min="1">
    </div>




    <br />
    <button type="submit" class="btn btn-success">Saída</button>

    <a class="btn btn-secondary" asp-controller="Produto" asp-action="Index">Voltar</a>
</form>

<script>


</script>
